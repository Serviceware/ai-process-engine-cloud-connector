{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serviceware.se/cloud-connector/schemas/forwarding.schema.json",
  "title": "Cloud Connector YAML Forwarding Configuration",
  "description": "Declarative forwarding configuration for all workload requests handled by one Cloud Connector instance.",
  "type": "object",
  "required": ["target"],
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute HTTP(S) target base URL. Environment interpolation such as {{ env.API_URL }} is supported."
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Optional uppercase HTTP methods to forward. All supported methods are enabled when omitted.",
      "items": {
        "type": "string",
        "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
      }
    },
    "timeout": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000,
      "default": 30000,
      "description": "Upstream timeout in milliseconds."
    },
    "request": { "$ref": "#/$defs/requestTransform" },
    "response": { "$ref": "#/$defs/responseTransform" }
  },
  "additionalProperties": false,
  "$defs": {
    "headerTransform": {
      "type": "object",
      "properties": {
        "add": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "set": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "remove": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "urlTransform": {
      "type": "object",
      "properties": {
        "prefix": { "type": "string" },
        "suffix": { "type": "string" },
        "removePrefix": { "type": "string" },
        "rewrite": { "type": "string" }
      },
      "additionalProperties": false
    },
    "requestTransform": {
      "type": "object",
      "properties": {
        "headers": { "$ref": "#/$defs/headerTransform" },
        "url": { "$ref": "#/$defs/urlTransform" },
        "body": {
          "type": "object",
          "properties": { "set": { "type": "string" } },
          "additionalProperties": false
        },
        "reject": {
          "type": "object",
          "properties": {
            "if": { "type": "string" },
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "responseTransform": {
      "type": "object",
      "properties": {
        "headers": { "$ref": "#/$defs/headerTransform" },
        "body": {
          "type": "object",
          "properties": { "set": { "type": "string" } },
          "additionalProperties": false
        },
        "statusCode": {
          "type": "object",
          "properties": {
            "set": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
