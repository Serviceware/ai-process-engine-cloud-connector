{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serviceware.se/cloud-connector/schemas/forwarding.schema.json",
  "title": "Edge Connector YAML Forwarding Configuration",
  "description": "Declarative forwarding configuration for all workload requests handled by one Edge Connector instance.",
  "type": "object",
  "required": ["target"],
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute HTTP(S) target base URL. Environment interpolation such as {{ env.API_URL }} is supported."
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Optional uppercase HTTP methods to forward. All supported methods are enabled when omitted.",
      "items": {
        "type": "string",
        "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
      }
    },
    "timeout": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000,
      "default": 30000,
      "description": "Upstream timeout in milliseconds."
    },
    "request": { "$ref": "#/$defs/requestConfig" },
    "response": { "$ref": "#/$defs/responseConfig" }
  },
  "additionalProperties": false,
  "$defs": {
    "headerConfig": {
      "type": "object",
      "properties": {
        "add": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "set": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "remove": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "requestConfig": {
      "type": "object",
      "properties": {
        "headers": { "$ref": "#/$defs/headerConfig" },
        "pathPrefix": {
          "type": "string",
          "pattern": "^/(?!/)[^?#]*$",
          "description": "Optional static path prefix applied before forwarding."
        }
      },
      "additionalProperties": false
    },
    "responseConfig": {
      "type": "object",
      "properties": {
        "headers": { "$ref": "#/$defs/headerConfig" }
      },
      "additionalProperties": false
    }
  }
}
