{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serviceware.se/cloud-connector/schemas/cloud-connector.schema.json",
  "title": "Serviceware Cloud Connector configuration",
  "type": "object",
  "required": ["connection", "forwarding"],
  "additionalProperties": false,
  "properties": {
    "connection": {
      "type": "object",
      "required": ["websocketUrl"],
      "additionalProperties": false,
      "properties": {
        "websocketUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^wss?://"
        },
        "heartbeatIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["error", "warn", "info", "debug"],
          "default": "info"
        }
      }
    },
    "forwarding": {
      "$ref": "#/$defs/forwardingConfig"
    }
  },
  "$defs": {
    "forwardingConfig": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "One absolute HTTP(S) target; env interpolation is allowed."
        },
        "outboundUrlAllowlist": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
          }
        },
        "timeout": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 30000
        },
        "request": {
          "$ref": "#/$defs/requestConfig"
        },
        "response": {
          "$ref": "#/$defs/responseConfig"
        }
      }
    },
    "headerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "add": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "remove": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "requestConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": { "$ref": "#/$defs/headerConfig" },
        "pathPrefix": {
          "type": "string",
          "pattern": "^/(?!/)[^?#]*$"
        }
      }
    },
    "responseConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": { "$ref": "#/$defs/headerConfig" }
      }
    }
  }
}
