# Cloud Connector Configuration
# =============================
# Copy this file to .env and adjust the values.

# WebSocket URL for the Serviceware Cloud (provided by Serviceware)
SERVICEWARE_HOST=https://dev.ai-process-engine.labs.swops.cloud
SERVICEWARE_CLIENT_ID=your-client-id
SERVICEWARE_CLIENT_SECRET=your-client-secret
SERVICEWARE_WS_URL=wss://cloud.serviceware.se/connector/ws?tenant=your-tenant
SERVICEWARE_LOG_LEVEL=info

# Workload URL allowlist (JSON array of regular expressions).
# Empty means deny all. Use [".*"] only to explicitly allow every URL.
OUTBOUND_URL_ALLOWLIST=[]
# Example for the INTERNAL_API_URL below:
# OUTBOUND_URL_ALLOWLIST=["^http://your-internal-api:3000(?:/|$)"]

# Required: Base URL of the only forwarding target
INTERNAL_API_URL=http://your-internal-api:3000

# Optional: API token referenced by forwarding.yml
INTERNAL_API_TOKEN=your-secret-api-token
