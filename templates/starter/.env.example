# Cloud Connector Configuration
# =============================
# Copy this file to .env and adjust the values.

# Serviceware Cloud host and OAuth credentials (provided by Serviceware)
SERVICEWARE_HOST=https://dev.ai-process-engine.labs.swops.cloud
SERVICEWARE_CLIENT_ID=your-client-id
SERVICEWARE_CLIENT_SECRET=your-client-secret

# docker-compose.yml maps these SERVICEWARE_* names to the runtime's
# CLOUD_CONNECTOR_HOST / CLOUD_CONNECTOR_CLIENT_ID / CLOUD_CONNECTOR_CLIENT_SECRET.

# Optional safety limits
CLOUD_CONNECTOR_MAX_CONCURRENT_REQUESTS=100
CLOUD_CONNECTOR_MAX_RESPONSE_BODY_BYTES=10485760
CLOUD_CONNECTOR_DRAIN_TIMEOUT_SECONDS=30

# Optional: API token referenced by cloud-connector.yml
INTERNAL_API_TOKEN=your-secret-api-token
