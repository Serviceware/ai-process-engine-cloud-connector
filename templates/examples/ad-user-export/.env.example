# AD User Export Configuration
# ============================
# Copy this file to .env and adjust the values.

# =============================================================================
# Serviceware Cloud
# =============================================================================

# WebSocket URL for the Serviceware Cloud (provided by Serviceware)
SERVICEWARE_HOST=https://dev.ai-process-engine.labs.swops.cloud
SERVICEWARE_CLIENT_ID=your-client-id
SERVICEWARE_CLIENT_SECRET=your-client-secret
SERVICEWARE_WS_URL=wss://cloud.serviceware.se/connector/ws?tenant=your-tenant
SERVICEWARE_LOG_LEVEL=info

# Permit only the internal bridge API used by this example.
OUTBOUND_URL_ALLOWLIST=["^http://ad-bridge:5000(?:/|$)"]

# =============================================================================
# Active Directory Connection
# =============================================================================

# LDAP server URL (ldap:// for plaintext, ldaps:// for TLS)
# Examples:
#   ldap://dc01.corp.example.com        (Port 389)
#   ldaps://dc01.corp.example.com       (Port 636, encrypted)
#   ldap://dc01.corp.example.com:3268   (Global Catalog)
AD_SERVER=ldap://dc01.corp.example.com

# Base DN for LDAP searches (must match the domain)
# Example for corp.example.com:
AD_BASE_DN=DC=corp,DC=example,DC=com

# Service account for LDAP bind
# Format 1: Distinguished Name
#   CN=svc_serviceware,OU=Service Accounts,DC=corp,DC=example,DC=com
# Format 2: User Principal Name
#   svc_serviceware@corp.example.com
# Format 3: DOMAIN\username
#   CORP\svc_serviceware
AD_BIND_USER=CN=svc_serviceware,OU=Service Accounts,DC=corp,DC=example,DC=com

# Service account password
AD_BIND_PASSWORD=your-service-account-password

# =============================================================================
# TLS/SSL (optional, recommended for production)
# =============================================================================

# Enable TLS (also for ldap:// with STARTTLS)
AD_USE_TLS=false

# Path to the CA certificate (if self-signed)
# AD_CERT_FILE=/certs/ad-ca.crt

# =============================================================================
# Bridge API Security
# =============================================================================

# API token for authentication between Cloud Connector and bridge
# Generate a random token:
#   openssl rand -base64 32
BRIDGE_API_TOKEN=your-random-api-token-here
