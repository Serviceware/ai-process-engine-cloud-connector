# ERP Integration Configuration
# =============================
# Copy this file to .env and adjust the values.

# WebSocket URL for the Serviceware Cloud (provided by Serviceware)
SERVICEWARE_HOST=https://dev.ai-process-engine.labs.swops.cloud
SERVICEWARE_CLIENT_ID=your-client-id
SERVICEWARE_CLIENT_SECRET=your-client-secret
SERVICEWARE_WS_URL=wss://cloud.serviceware.se/connector/ws?tenant=your-tenant
SERVICEWARE_LOG_LEVEL=info

# SAP Gateway URL
ERP_URL=https://sap-gateway.example.com

# SAP service account credentials
ERP_USER=svc_serviceware
ERP_PASSWORD=your-secret-password

# SAP system ID (optional, default: PRD)
ERP_SYSTEM=PRD
