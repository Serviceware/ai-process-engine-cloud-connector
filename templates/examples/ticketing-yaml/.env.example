# Ticketing YAML Forwarding Configuration
# ========================================
# Copy this file to .env and adjust the values.

# Serviceware Cloud host and OAuth credentials (provided by Serviceware)
SERVICEWARE_HOST=https://dev.ai-process-engine.labs.swops.cloud
SERVICEWARE_CLIENT_ID=your-client-id
SERVICEWARE_CLIENT_SECRET=your-client-secret

# Ticketing API secret referenced by cloud-connector.yml
TICKET_API_TOKEN=your-secret-api-token
