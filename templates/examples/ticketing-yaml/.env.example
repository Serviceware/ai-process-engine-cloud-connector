# Ticketing YAML Forwarding Configuration
# ========================================
# Copy this file to .env and adjust the values.

# WebSocket URL for the Serviceware Cloud (provided by Serviceware)
SERVICEWARE_HOST=https://dev.ai-process-engine.labs.swops.cloud
SERVICEWARE_CLIENT_ID=your-client-id
SERVICEWARE_CLIENT_SECRET=your-client-secret
SERVICEWARE_WS_URL=wss://cloud.serviceware.se/connector/ws?tenant=your-tenant
SERVICEWARE_LOG_LEVEL=info

# Permit only the ticketing API used by this example.
OUTBOUND_URL_ALLOWLIST=["^http://ticketing-api:3000(?:/|$)"]

# Ticketing API URL (the internal ticketing system)
TICKET_API_URL=http://ticketing-api:3000

# Ticketing API Token
TICKET_API_TOKEN=your-secret-api-token
